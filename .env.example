DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS = _env_list('ALLOWED_HOSTS', 'localhost,127.0.0.1')
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/school_system
DB_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=SmartSchool <your-email@example.com>
SERVER_EMAIL=server-errors@yourdomain.com
PASSWORD_RESET_TIMEOUT=3600
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=SmartSchool
TERMII_BASE_URL=https://api.termii.com/api/sms/send
PARENT_NOTIFICATION_CHANNEL=whatsapp
